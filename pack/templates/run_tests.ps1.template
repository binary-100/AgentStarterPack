#Requires -Version 5.1
<#
.SYNOPSIS
  Project test suite. One implementation, wrapped by run_tests.bat and run_tests.sh.

.DESCRIPTION
  Both wrappers delegate here so every OS runs the same suite. This logic used to live in
  run_tests.bat, which made the project's tests Windows-only by construction - and because the
  audit runs this script to earn its test-pass proof, the audit could not complete off Windows
  either.
#>
$ErrorActionPreference = 'Continue'
$Root = Split-Path -Parent $PSScriptRoot
Set-Location $Root
$env:PYTHONPATH = $Root
$failed = 0

# Resolved here rather than borrowed from the starter pack: running this project's tests must not
# require the pack to be installed. `py` is the Windows launcher and does not exist anywhere else,
# where the interpreter is python3.
function Get-ProjectPython {
    foreach ($cand in @(
            @{ exe = 'py'; pre = @('-3') },
            @{ exe = 'python3'; pre = @() },
            @{ exe = 'python'; pre = @() })) {
        if (-not (Get-Command $cand.exe -ErrorAction SilentlyContinue)) { continue }
        $null = & $cand.exe @($cand.pre + @('--version')) 2>&1
        if ($LASTEXITCODE -eq 0) { return $cand }
    }
    return $null
}

$py = Get-ProjectPython
if (-not $py) {
    Write-Host 'ERROR: Python 3 not found. Tried the Windows launcher (py -3), python3 and python.'
    exit 1
}

function Invoke-ProjectPython {
    param([Parameter(ValueFromRemainingArguments = $true)]$Arguments)
    $flat = @()
    foreach ($a in @($py.pre) + @($Arguments)) {
        if ($null -eq $a) { continue }
        if ($a -is [System.Array]) { $flat += @($a) } else { $flat += $a }
    }
    & $py.exe @flat
}

# Version and documentation sync, for projects that have that pipeline. A file test rather than two
# separate runners: the generic stack simply has no apply_version.py.
$applyVersion = Join-Path $Root 'scripts/apply_version.py'
if (Test-Path -LiteralPath $applyVersion) {
    Write-Host 'Syncing version and documentation...'
    Invoke-ProjectPython $applyVersion 'sync'
    if ($LASTEXITCODE -ne 0) {
        Write-Host 'Version/doc sync failed.'
        exit 1
    }
}

Write-Host "Test suite (PYTHONPATH=$Root)"
Write-Host ''

$testDir = Join-Path $Root 'tests'
$tests = @()
if (Test-Path -LiteralPath $testDir) {
    # -Filter, not -Include: Get-ChildItem -Include without -Recurse silently matches everything.
    $tests = @(Get-ChildItem -LiteralPath $testDir -Filter 'test_*.py' -File -ErrorAction SilentlyContinue | Sort-Object Name)
}
if ($tests.Count -eq 0) {
    Write-Host 'No tests found under tests/ - a suite that runs nothing must not report success.'
    exit 1
}

foreach ($t in $tests) {
    Write-Host "=== tests/$($t.Name) ==="
    Invoke-ProjectPython $t.FullName
    if ($LASTEXITCODE -ne 0) { $failed = 1 }
    Write-Host ''
}

if ($failed -ne 0) {
    Write-Host 'One or more tests failed.'
    exit 1
}
Write-Host 'All tests passed.'
exit 0
