{
  "configVersion": 1,
  "projectName": "BSOD Analyzer",

  "versionSync": {
    "codeFile": "bsod_analyzer.py",
    "codePattern": "^VERSION = \"([^\"]+)\"",
    "txtFile": "VERSION.txt",
    "txtPattern": "^Version:\\s*(\\S+)",
    "distTxtFile": "BSODAnalyzer_v6/VERSION.txt",
    "distTxtPattern": "Version:\\s*(\\d+\\.\\d+\\.\\d+)"
  },

  "tests": {
    "script": "run_tests.bat",
    "env": {
      "QT_QPA_PLATFORM": "offscreen"
    }
  },

  "requiredPaths": {
    "app": [
      "bsod_analyzer.py",
      "run_tests.bat",
      "run_audit.cmd",
      "build_ci.bat",
      "docs/AUDIT.md",
      "docs/AUDIT.config.json",
      ".cursor/rules/audit.mdc",
      "AGENTS.md",
      "BSODAnalyzer_v6/BSODAnalyzer.exe"
    ],
    "repo": [
      "README.md",
      "PROJECT_LAYOUT.md"
    ]
  },

  "staleDocs": {
    "pattern": "BSODAnalyzer_Opus|junction|interim rename|Complete_Phase6",
    "excludeFiles": ["AUDIT.md"],
    "excludeDirs": ["audit_archive", "release_notes", "design_archive"],
    "scanRepoMd": true,
    "scanAppDocsMd": true,
    "extraFiles": ["BUILD_NOTES.md", "CONSOLIDATION.md", "AGENTS.md"]
  },

  "cruft": {
    "dirs": ["dist", "build", "BSODAnalyzer_v6_stable"],
    "globFiles": ["live_*.json"],
    "logDirs": ["repo", "app"],
    "cacheExcludeRegex": "\\\\tests\\\\|\\\\BSODAnalyzer_v6\\\\|\\\\DebuggingTools\\\\|_internal\\\\|\\\\app\\\\__pycache__$"
  },

  "obsoletePaths": {
    "repo": [
      "Complete_Phase6_Rename.cmd",
      "Consolidate_Project.cmd",
      "scripts/consolidate_project.ps1",
      "scripts/complete_phase6_rename.ps1",
      "proposed_patches"
    ],
    "desktopFolder": "BSODAnalyzer_Opus"
  },

  "domainMap": {
    "auditMd": "docs/AUDIT.md",
    "sectionHeading": "## Domain map",
    "scanGlob": "*.py",
    "scanDir": ".",
    "moduleSearchDirs": [".", "scripts"],
    "excludeModules": ["preview_amd_logos.py"],
    "wildcardPatterns": ["gui_*", "firmware_peripheral_*.py"],
    "orphanScanEnabled": true
  },

  "stables": {
    "enabled": true,
    "desktopFolder": "BSODAnalyzer_StableBuilds",
    "expected": ["v6.1.20", "v6.2.3", "v6.4.61"]
  },

  "secretsScan": {
    "enabled": true,
    "extensions": [".py", ".ps1", ".md", ".json", ".env", ".bat", ".cmd", ".txt", ".yaml", ".yml", ".spec"],
    "excludePathRegex": "\\\\tests\\\\fixtures\\\\|\\\\DebuggingTools\\\\|\\\\BSODAnalyzer_v6\\\\|_internal\\\\|audit_archive\\\\"
  },

  "syncAndVerify": {
    "runSyncVerify": true,
    "runLegacyVerify": true,
    "autoFixDrift": true
  },

  "codeChecks": {
    "importSmoke": {
      "enabled": true,
      "exclude": ["preview_amd_logos.py"]
    },
    "semanticReportFile": "docs/.audit_semantic_report.json",
    "semanticReportRequireCites": true,
    "semanticReportRequireEvidence": true,
    "semanticReportEvidenceMinWhenNotClean": 1,
    "semanticReportEvidenceRequireFileWhenNotClean": true,
    "semanticReportRequiredInRunAudit": true,
    "semanticBlockCleanWhenMachineFails": true,
    "semanticFreshnessCheck": true,
    "semanticRequireTestsGitHead": true,
    "semanticRequireModulesReviewed": true,
    "semanticModulesReviewedSections": ["D", "E", "F", "G", "H", "I", "J", "K"],
    "inventoryFile": "docs/.audit_inventory.json",
    "inventoryRequireAck": true,
    "expandedDomainMapFile": "docs/.audit_domain_expanded.json",
    "receiptFile": "docs/.audit_receipt.json",
    "allowlistFile": "docs/audit_allowlist.json",
    "largeModuleLocThreshold": 2000,
    "deadCodeScan": {
      "enabled": true,
      "maxReports": 8
    },
    "testGapHints": {
      "enabled": true,
      "sections": ["D", "E", "F", "G", "H", "I", "J", "K"],
      "maxModulesListed": 5
    },
    "sectionMachineChecks": {
      "B": {
        "enabled": true,
        "layoutRequiredPaths": [
          "app/run_tests.bat",
          "app/run_audit.cmd",
          "app/docs/AUDIT.md",
          "app/docs/AUDIT.config.json",
          "README.md",
          "PROJECT_LAYOUT.md"
        ],
        "repoRootPaths": [
          "README.md",
          "PROJECT_LAYOUT.md",
          "ONEDRIVE_CLEANUP.md",
          "AGENTS.md"
        ],
        "onedriveDoc": "ONEDRIVE_CLEANUP.md"
      },
      "C": {
        "enabled": true,
        "requiredPaths": [
          "BSODAnalyzer.spec",
          "build_ci.bat",
          "scripts/finalize_portable_dist.py",
          "scripts/sync_dist_readme.py"
        ],
        "distMarker": "BSODAnalyzer_v6/BSODAnalyzer.exe",
        "bundledRuntimePaths": [
          "BSODAnalyzer_v6/_internal/DebuggingTools/x64/cdb.exe"
        ],
        "forbidDuplicateRootPaths": [
          "BSODAnalyzer_v6/DebuggingTools"
        ],
        "sectionTests": [
          "tests/test_portable_build_smoke.py",
          "tests/test_powershell7.py",
          "tests/test_seven_zip_runtime.py"
        ]
      },
      "L": {
        "enabled": true,
        "forbiddenRules": [
          "code-audit-checklist.mdc",
          "generic-code-audit-checklist.mdc",
          "bsod-analyzer-audit-overlay.mdc"
        ],
        "forbidDuplicateSkill": "agent-code-audit",
        "agentsMdRequiredPhrases": ["run_audit.cmd", "run_tests.bat", "never `-SkipTests`", "build_ci.bat"],
        "gitignoreAuditArtifacts": [
          "docs/.audit_agent_manifest.json",
          "docs/.audit_semantic_report.json",
          "docs/.audit_timing.jsonl",
          "docs/.audit_inventory.json",
          "docs/.audit_domain_expanded.json",
          "docs/.audit_receipt.json"
        ]
      },
      "N": {
        "enabled": true,
        "gitLogPaths": ["app/bsod_analyzer.py", "app/VERSION.txt"],
        "gitMaxCommits": 8,
        "blockCleanSummaryIfGitHits": true
      },
      "M": {
        "enabled": true,
        "scanGlobs": ["docs/*.md"],
        "htmlScanGlobs": ["docs/*.html"],
        "excludeFiles": [
          "AUDIT.md",
          "IMPROVEMENT_BACKLOG.md",
          "KNOWN_LIMITATIONS.md",
          "ROADMAP.md",
          "PRODUCT_REFERENCE.md",
          "DRIVER_VERIFICATION_PLAN.md"
        ],
        "scanRepoReadme": true,
        "repoFiles": ["README.md", "PROJECT_LAYOUT.md", "BUILD_NOTES.md", "CONSOLIDATION.md"]
      },
      "F": {
        "enabled": true,
        "agentsMdRequiredPhrases": ["portable first", "Portable-first product direction"]
      }
    },
    "staticPatterns": [
      {
        "id": "bare-except",
        "section": "K",
        "glob": "*.py",
        "excludePathRegex": "\\\\tests\\\\|\\\\scripts\\\\",
        "forbiddenRegex": "^\\s*except\\s*:\\s*(#.*)?$",
        "message": "bare except — use a specific exception type"
      },
      {
        "id": "except-pass",
        "section": "K",
        "glob": "*.py",
        "excludePathRegex": "\\\\tests\\\\",
        "forbiddenRegex": "^\\s*except\\s+.*:\\s*pass\\s*(#.*)?$",
        "message": "except pass swallows failures"
      },
      {
        "id": "stale-opus-path",
        "section": "M",
        "glob": "*.py",
        "excludePathRegex": "\\\\tests\\\\fixtures\\\\",
        "forbiddenRegex": "BSODAnalyzer_Opus",
        "message": "stale Opus path in source"
      },
      {
        "id": "subprocess-shell",
        "section": "K",
        "glob": "*.py",
        "excludePathRegex": "\\\\tests\\\\",
        "forbiddenRegex": "subprocess\\.(run|Popen|call)\\([^\\)]*shell\\s*=\\s*True",
        "message": "subprocess shell=True — use list args without shell"
      },
      {
        "id": "os-system",
        "section": "K",
        "glob": "*.py",
        "excludePathRegex": "\\\\tests\\\\",
        "forbiddenRegex": "os\\.system\\(",
        "message": "os.system — use subprocess with list args"
      },
      {
        "id": "eval-call",
        "section": "K",
        "glob": "*.py",
        "excludePathRegex": "\\\\tests\\\\",
        "forbiddenRegex": "\\beval\\(",
        "message": "eval() — security risk"
      },
      {
        "id": "exec-call",
        "section": "K",
        "glob": "*.py",
        "excludePathRegex": "\\\\tests\\\\",
        "forbiddenRegex": "(?<!\\.)exec\\(",
        "message": "exec() — security risk"
      },
      {
        "id": "hardcoded-secret",
        "section": "K",
        "glob": "*.py",
        "excludePathRegex": "\\\\tests\\\\|\\\\scripts\\\\",
        "forbiddenRegex": "(?i)(password|api_key|secret_key|auth_token)\\s*=\\s*[\"'][^\"']{6,}[\"']",
        "message": "possible hardcoded credential"
      },
      {
        "id": "yaml-unsafe-load",
        "section": "K",
        "glob": "*.py",
        "excludePathRegex": "\\\\tests\\\\",
        "forbiddenRegex": "yaml\\.load\\(",
        "allowLineRegex": "SafeLoader|safe_load",
        "message": "yaml.load without SafeLoader — use yaml.safe_load"
      },
      {
        "id": "pickle-loads",
        "section": "K",
        "glob": "*.py",
        "excludePathRegex": "\\\\tests\\\\",
        "forbiddenRegex": "pickle\\.loads?\\(",
        "message": "pickle load — untrusted data risk"
      }
    ],
    "sectionTests": {
      "C": ["tests/test_portable_build_smoke.py", "tests/test_powershell7.py", "tests/test_seven_zip_runtime.py"],
      "D": ["tests/test_version_consistency.py", "tests/test_batch1_v529.py"],
      "E": ["tests/test_gui_main_thread_guard.py", "tests/test_pre_compile_hygiene.py"],
      "F": ["tests/test_data_dir_settings.py"],
      "G": ["tests/test_catalog_audit_coverage.py", "tests/test_parser_rot_detection.py", "tests/test_vendor_source_hardening.py"],
      "H": ["tests/test_vendor_firmware_fetch.py", "tests/test_firmware_catalog_parity.py"],
      "I": ["tests/test_catalog_export.py", "tests/test_driver_install_flow.py"],
      "J": ["tests/test_session_log.py"],
      "K": ["tests/test_vendor_source_hardening.py"]
    },
    "semanticReviewHints": {
      "A": ["Full test suite coverage", "Version sync across dist"],
      "B": ["Repo layout vs PROJECT_LAYOUT", "Stale paths and cruft"],
      "C": ["Portable dist layout", "Bundled runtime paths"],
      "D": ["Latest minidump/event selection logic", "Crash-linked driver deferral"],
      "E": ["Worker shutdown and cancel paths", "Progress bar reset on error"],
      "F": ["Portable-first for new code paths", "OneDrive settings fallback"],
      "G": ["Driver catalog scoring regressions", "Vendor fetch timeout surfacing"],
      "H": ["Firmware SSD vs peripheral coverage", "Batch warm cancel"],
      "I": ["Export path portable vs full-install", "Install flow error messages"],
      "J": ["Log rotation edge cases"],
      "K": ["Subprocess quoting with user paths"],
      "L": ["No legacy audit rules in project", "AGENTS.md command accuracy"],
      "M": ["Doc headers vs VERSION.txt", "Archived vs active docs"],
      "N": ["Release delta vs sections D-M when VERSION bumped"]
    }
  }
}
