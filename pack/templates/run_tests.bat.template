@echo off
REM Copy to project root as run_tests.bat - adjust PYTHONPATH and test glob.

cd /d "%~dp0"
set "PYTHONPATH=."
set "FAILED=0"

REM --- Build pipeline: version + documentation sync (before tests) ---
echo Syncing version and documentation...
py -3 scripts\apply_version.py sync
if errorlevel 1 (
    echo Version/doc sync failed.
    exit /b 1
)

echo Test suite (PYTHONPATH=%CD%)
echo.

for %%F in (tests\test_*.py) do (
    echo === %%F ===
    py -3 "%%F"
    if errorlevel 1 set FAILED=1
    echo.
)

if %FAILED% neq 0 (
    echo One or more tests failed.
    exit /b 1
)
echo All tests passed.
exit /b 0
