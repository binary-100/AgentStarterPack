#!/usr/bin/env bash
# Test suite entry (same as run_tests.bat on Windows).
# Thin wrapper: the implementation is scripts/run_tests.ps1, so both platforms run the same suite.
# The pwsh check is inline rather than sourced from the starter pack because a generated project
# must be able to run its own tests without the pack installed.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
if ! command -v pwsh >/dev/null 2>&1; then
  echo "ERROR: PowerShell 7 (pwsh) is required to run the tests on this OS." >&2
  echo "Install: https://learn.microsoft.com/powershell/scripting/install/installing-powershell" >&2
  exit 1
fi
exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/run_tests.ps1" "$@"
