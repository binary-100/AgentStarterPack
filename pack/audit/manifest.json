  "_comment_distributionChannels": "WQ-442: the ways this pack reaches a machine that did not build it. Each must honour every distributionCriticalKey - that is precisely what WQ-439 (export shipped what install stripped) and WQ-425 (install kept what export dropped) each got wrong in opposite directions.",
  "distributionChannels": [
    "install.ps1",
    "export.ps1"
  ],
  "distributionCriticalKeys": [
    "machineLocalPaths",
    "maintainerOnlyPaths",
    "repoOnlyPaths"
  ],

  "_repoOnlyPaths": "Paths that belong in Airlock repo/ only (CI workflows). install.ps1 and export.ps1 strip them; sync-working-copy-to-airlock-repo.ps1 materializes them from pack/templates/airlock/repo/ after mirror.",
  "repoOnlyPaths": [
    ".github"
  ],

