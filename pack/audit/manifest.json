    "_machineLocalPaths": "Files that record one machine's absolute paths, versions or install state, and must never exist in this checkout. Since 2.22.59 nothing writes them here: Get-AgentStateRoot (mirrored by agent_state_root in agent_context_freshness.py) sends the four agent-context artifacts to a machine-local state directory outside the pack folder, and ensure-work-completion.ps1 generates no overlay for a pack root. This list is what enforces and cleans that - behavior step 50 fails if any entry exists in the checkout, is tracked in git, is missing from .gitignore, or appears in packMirror; sanitize-machine-state.ps1 removes them from a folder that arrived by copy, and export.ps1 drops them from an archive. Ordinary projects are unaffected: their docs/ is the right home for a brief naming their own single location. Wildcard classes (docs/.audit_*, __pycache__, *.pyc, .tmp) are handled by pattern in the sanitizer and the export.",
  "machineLocalPaths": [
    "install-manifest.json",
    "docs/AGENT_CONTEXT.json",
    "docs/AGENT_REFRESH.md",
    "docs/AGENT_PASTE.txt",
    "docs/AGENT_SESSION_START.md",
    "docs/WORK_COMPLETION.md"
  ],

  "_maintainerOnlyPaths": "Repo files that belong to pack development and must not land in a user's install. install.ps1 copies the whole checkout, so anything not listed here ships to %USERPROFILE%; sync-audit-system.ps1 also deletes these from an existing install. Session handoffs and implementation specs are notes between maintainers - they age badly and mean nothing to someone who just installed the pack.",
  "_comment_listConsumers": "WQ-442: every script that must read a manifest list, declared. A list having one home is not enough - nothing enumerated its readers, so each consumer was discovered by shipping the bug (WQ-424 to 439). Behavior step 60 fails when a declared reader stops reading its key, and when a script reads a distribution-critical key without being declared here.",
  "listConsumers": {
    "machineLocalPaths": [
      "install.ps1",
      "export.ps1",
      "pack/scripts/sanitize-machine-state.ps1",
      "pack/scripts/simulate-airlock-scenarios.ps1",
      "pack/scripts/sync-audit-system.ps1",
      "pack/scripts/sync-working-copy-to-airlock-repo.ps1",
      "pack/scripts/verify-agent-setup.ps1",
      "pack/scripts/verify-audit-behavior.ps1"
    ],
    "maintainerOnlyPaths": [
      "install.ps1",
      "export.ps1",
      "pack/scripts/pack-paths.ps1",
      "pack/scripts/simulate-airlock-scenarios.ps1",
      "pack/scripts/sync-audit-system.ps1",
      "pack/scripts/sync-working-copy-to-airlock-repo.ps1",
      "pack/scripts/verify-audit-behavior.ps1"
    ],
    "repoOnlyPaths": [
      "install.ps1",
      "export.ps1",
      "pack/scripts/simulate-airlock-scenarios.ps1",
      "pack/scripts/sync-working-copy-to-airlock-repo.ps1",
      "pack/scripts/verify-audit-behavior.ps1"
    ],
    "packMirror": [
      "export.ps1",
      "pack/scripts/sync-audit-system.ps1",
      "pack/scripts/verify-agent-setup.ps1",
      "pack/scripts/verify-audit-behavior.ps1",
      "pack/scripts/verify-audit-system.ps1"
    ],
    "packToUser": [
      "pack/scripts/sync-audit-system.ps1",
      "pack/scripts/verify-agent-setup.ps1",
      "pack/scripts/verify-audit-behavior.ps1"
    ],
    "forbiddenArtifacts": [
      "pack/scripts/audit_code_checks.py",
      "pack/scripts/run_audit_core.ps1",
      "pack/scripts/verify-audit-behavior.ps1",
      "pack/scripts/verify-audit-system.ps1"
    ],
    "forbiddenPackPaths": [
      "pack/scripts/sync-audit-system.ps1",
      "pack/scripts/verify-audit-behavior.ps1",
      "pack/scripts/verify-audit-system.ps1"
    ],
    "pathRulePrimitiveAllowlist": [
      "pack/scripts/verify-audit-behavior.ps1"
    ]
