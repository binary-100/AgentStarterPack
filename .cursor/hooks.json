{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/shell-preapprove.ps1",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/offload-detect.ps1",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/completion-gate.ps1",
        "timeout": 15,
        "loop_limit": 1
      }
    ]
  }
}
