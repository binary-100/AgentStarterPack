__pycache__/
*.pyc
*.pyo
dist/
*.zip
.DS_Store

# Machine-specific install record - written into the install target, never the checkout
install-manifest.json

# Behavior-fixture audit artifacts - regenerated by run_audit_tests.bat
pack/audit/behavior-fixture/docs/.audit_*

# Scratch roots for self-tests (mirror-direction probe)
.tmp/

# Audit artifacts (pack self-audit)
docs/.audit_agent_manifest.json
docs/.audit_semantic_report.json
docs/.audit_timing.jsonl
docs/.audit_inventory.json
docs/.audit_domain_expanded.json
docs/.audit_receipt.json

# Generated by Refresh-AgentContext.cmd - records this machine's pack paths and versions
docs/AGENT_CONTEXT.json
docs/AGENT_REFRESH.md
docs/AGENT_PASTE.txt
