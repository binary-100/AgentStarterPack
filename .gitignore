__pycache__/
*.pyc
*.pyo
dist/
*.zip
.DS_Store

# Machine-specific install record - written into the install target, never the checkout
install-manifest.json

# Behavior-fixture audit artifacts - regenerated by run_audit_tests.bat
pack/audit/behavior-fixture/docs/.audit_*

# Scratch roots for self-tests (mirror-direction probe)
.tmp/

# Audit artifacts (pack self-audit)
docs/.audit_agent_manifest.json
docs/.audit_semantic_report.json
docs/.audit_timing.jsonl
docs/.audit_inventory.json
docs/.audit_domain_expanded.json
docs/.audit_receipt.json

# Machine-local files - the canonical list is machineLocalPaths in pack/audit/manifest.json, and
# behavior step 50 fails if these two lists disagree.
#
# Since 2.22.59 nothing writes these here: Refresh-AgentContext.cmd sends the four agent-context
# artifacts to %LOCALAPPDATA%\AgentStarterPack\state\<checkout> (this folder travels, so a file naming
# this machine's drive and user profile does not belong in it), and ensure-work-completion.ps1
# generates no overlay for a pack root - pack/docs/WORK_COMPLETION.md is the canonical checklist.
#
# Kept as belt-and-braces for older copies, where they were written into docs/ and two of them were
# committed with a maintainer's profile path. Step 50 fails if any of them exist here at all.
docs/AGENT_CONTEXT.json
docs/AGENT_REFRESH.md
docs/AGENT_PASTE.txt
docs/AGENT_SESSION_START.md
docs/WORK_COMPLETION.md

# Machine-scoped agent rule: true on the maintainer's working copy, false on the machine
# that publishes. Committing it would tell an agent there to refuse the push it is being asked for.
.cursor/rules/no-publish-from-this-machine.mdc
