{
  "description": "Agent Starter Pack - build pipeline version + maintainer doc sync.",
  "canonical": {
    "txtFile": "VERSION",
    "txtPattern": "^(\\d+\\.\\d+\\.\\d+)"
  },
  "historicalRegions": [
    {
      "_why": "Done-log rows say which engine shipped an item - a claim about the past. The header above says which engine is current. Only the header may move on a bump (WQ-437).",
      "file": "docs/WORK_QUEUE.md",
      "fromHeading": "## Done log"
    }
  ],
  "maintainerDocSync": {
    "enabled": true,
    "packVersionScanFiles": [
      "README.md",
      "INSTALL.md",
      "pack/docs/START_HERE.md",
      "docs/WORK_QUEUE.md"
    ],
    "auditManifestPath": "pack/audit/manifest.json",
    "auditVersionScanFiles": [
      "README.md",
      "INSTALL.md",
      "pack/docs/START_HERE.md",
      "pack/docs/AUDIT_SYSTEM.md",
      "pack/docs/README.md",
      "pack/docs/AGENT_WORKFLOW.md",
      "docs/WORK_QUEUE.md"
    ],
    "auditContextKeywords": ["manifest.json", "audit engine", "starter pack"],
    "extraReplacements": [
      {
        "file": "pack/scripts/bootstrap-project.ps1",
        "pattern": "bootstrapVersion\\s*=\\s*\"\\d+\\.\\d+\\.\\d+\"",
        "replace": "bootstrapVersion = \"{packVersion}\"",
        "versionKind": "pack"
      },
      {
        "file": "docs/WORK_QUEUE.md",
        "pattern": "\\| \\*\\*Pack version\\*\\* \\| \\d+\\.\\d+\\.\\d+ \\|",
        "replace": "| **Pack version** | {packVersion} |",
        "versionKind": "pack"
      },
      {
        "file": "docs/WORK_QUEUE.md",
        "pattern": "\\| \\*\\*Audit engine\\*\\* \\| \\d+\\.\\d+\\.\\d+ \\|",
        "replace": "| **Audit engine** | {auditVersion} |",
        "versionKind": "audit"
      },
      {
        "file": "INSTALL.txt",
        "pattern": "QUICK INSTALL \\(v\\d+\\.\\d+\\.\\d+\\)",
        "replace": "QUICK INSTALL (v{packVersion})",
        "versionKind": "pack"
      },
      {
        "_why": "Only the header line above was synced, so the engine cite drifted to 2.22.43 while the manifest read 2.22.77 - a 34-release lie in the file a human on a new machine reads first. INSTALL.txt is plain text and not in auditVersionScanFiles, which only scans .md.",
        "file": "INSTALL.txt",
        "pattern": "manifest\\.json  \\(currently \\d+\\.\\d+\\.\\d+\\)",
        "replace": "manifest.json  (currently {auditVersion})",
        "versionKind": "audit"
      }
    ]
  }
}
